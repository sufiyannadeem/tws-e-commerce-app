# ================================
# Stage 1: Dependencies
# ================================
FROM node:22-alpine AS deps

WORKDIR /app

RUN apk upgrade --no-cache

COPY package.json package-lock.json ./

# Install only production dependencies
RUN npm ci --omit=dev

# ts-node requires TypeScript at runtime
RUN npm install --no-save --package-lock=false typescript@5.9.3


# ================================
# Stage 2: Migration Runtime
# ================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN apk upgrade --no-cache

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 migration

# Copy production dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy migration files
COPY scripts ./scripts

# Copy migration data
COPY .db ./.db

# Remove npm/corepack from final runtime image
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack

# Set permissions
RUN chown -R migration:nodejs /app

USER migration

CMD ["node_modules/.bin/ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
