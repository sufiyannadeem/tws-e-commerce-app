# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:22-alpine AS deps

WORKDIR /app

# Required for native Node modules
RUN apk upgrade --no-cache \
    && apk add --no-cache \
        python3 \
        make \
        g++

# Copy dependency files
COPY package.json package-lock.json ./

# Install exact dependencies
RUN npm ci


# ============================================
# Stage 2: Migration Runtime
# ============================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Apply latest Alpine security updates
RUN apk upgrade --no-cache

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 migration

# Copy installed dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy migration configuration and source
COPY scripts ./scripts

# Copy database seed/data files
COPY .db ./.db

# Give application user ownership
RUN chown -R migration:nodejs /app

USER migration

# Run migration directly with ts-node.
# No npm/npx is required at runtime.
CMD ["node_modules/.bin/ts-node", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
